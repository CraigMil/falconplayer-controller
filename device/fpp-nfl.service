[Unit]
Description=Falcon Player NFL Scoreboard
After=network-online.target fpp.service
Wants=network-online.target

[Service]
Type=simple
User=fpp
Environment=FPP_HOST=127.0.0.1
ExecStart=/home/fpp/fpp-worldclock-venv/bin/fpp --host 127.0.0.1 scoreboard --league nfl --interval 15
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
